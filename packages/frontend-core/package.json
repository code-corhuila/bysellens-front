{
  "name": "@bysellens/frontend-core",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "files": ["dist", "assets", "testing"],
  "sideEffects": ["**/*.css"],
  "exports": {
    "./configuracion": { "types": "./dist/configuracion.d.ts", "import": "./dist/configuracion.js" },
    "./modelos": { "types": "./dist/modelos.d.ts", "import": "./dist/modelos.js" },
    "./api": { "types": "./dist/api.d.ts", "import": "./dist/api.js" },
    "./mock": { "types": "./dist/mock/almacen.d.ts", "import": "./dist/mock/almacen.js" },
    "./auth/*": { "types": "./dist/auth/*.d.ts", "import": "./dist/auth/*.js" },
    "./components/*": { "types": "./dist/components/*.d.ts", "import": "./dist/components/*.js" },
    "./runtime/*": { "types": "./dist/runtime/*.d.ts", "import": "./dist/runtime/*.js" },
    "./styles/*": "./dist/styles/*",
    "./testing/*": "./testing/*",
    "./assets/*": "./assets/*"
  },
  "scripts": { "build": "tsc -p tsconfig.json && node copiar-recursos.mjs" },
  "peerDependencies": {
    "react": "19.0.0", "react-dom": "19.0.0",
    "@ionic/react": "^9.0.0", "@ionic/react-router": "^9.0.0",
    "react-router": "^6.30.0", "react-router-dom": "^6.30.1", "ionicons": "^8.1.0"
  },
  "dependencies": { "axios": "^1.20.0" },
  "devDependencies": { "typescript": "~5.9.0", "@types/react": "19.0.10", "@types/react-dom": "19.0.4" }
}
